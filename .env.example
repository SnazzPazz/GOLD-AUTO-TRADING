# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# --- OANDA (only needed for `python main.py demo --broker oanda`) ---
# Sign up for a FREE practice/demo account at https://www.oanda.com/demo-account/tpa/personal_info
# It streams the same live market prices as a real account, with fake money.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
# Leave as "practice". Switching to "live" also requires LIVE_TRADING_CONFIRMED=yes
# below, and this codebase does not wire up any live-order path even then.
OANDA_ENVIRONMENT=practice
LIVE_TRADING_CONFIRMED=no

INSTRUMENT=XAU_USD
CANDLE_GRANULARITY=M15
POLL_INTERVAL_SECONDS=60

# --- Simulated broker (no OANDA account needed) ---
STARTING_DEMO_BALANCE=10000

# --- Sentiment ---
ENABLE_SENTIMENT=true

# --- Strategy ---
# How many independent confirmations (trend/momentum/pattern/Bollinger) must
# agree before a signal fires. Higher = fewer, more selective trades.
MIN_CONFIRMATIONS=2

# --- Risk management ---
RISK_PER_TRADE_PCT=0.01
ATR_STOP_MULTIPLE=1.5
REWARD_RISK_RATIO=1.5
MAX_DAILY_LOSS_PCT=0.03
MAX_DRAWDOWN_PCT=0.10
MAX_CONCURRENT_POSITIONS=1
MAX_LEVERAGE=10
# Caps new trades per calendar day to stop whipsaw/overtrading in choppy conditions.
MAX_TRADES_PER_DAY=5
# Approximate round-trip bid/ask spread cost per unit (price terms), charged on every
# simulated close so backtest/demo results aren't flattered by frictionless fills.
SPREAD_COST_PER_UNIT=0.30

# --- Approval gate (final pre-execution checks, see risk/approval_gate.py) ---
# Reject a trade if price has drifted more than this many stop-distances from the
# signal's price by the time execution would happen (guards against stale/slipped fills).
MAX_SLIPPAGE_ATR_MULTIPLE=0.5
# Volatility-regime filter: skip trading when current ATR falls outside these
# percentiles of its own recent history (too quiet = noise, too wild = unusual event).
VOLATILITY_REGIME_LOOKBACK=100
VOLATILITY_REGIME_LOW_PERCENTILE=10
VOLATILITY_REGIME_HIGH_PERCENTILE=95
